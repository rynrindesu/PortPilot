# ---------------------------------------------------------------------------
# rescheduling_agent
# ---------------------------------------------------------------------------
OCEANX_VESSELS_DUE_TO_ARRIVE_API_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
PORTPILOT_AUTOMATION_ENABLED=

# LLM_PROVIDER selects the model backend: "groq" or "bedrock"
LLM_PROVIDER=bedrock

# Used when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Used when LLM_PROVIDER=bedrock
BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# port_ops_agent
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
